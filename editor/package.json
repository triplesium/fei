{
    "name": "@entisium/editor",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "node tools/dev.mjs",
        "dev:host": "npm run dev:server",
        "dev:renderer": "vite",
        "dev:sandbox": "npm run sandbox:prepare && npm run dev -- --project ../.sandbox/editor-project",
        "sandbox:prepare": "node tools/sandbox-project.mjs --prepare-only",
        "start": "node dist/server/main.js",
        "agent": "node --conditions=development --import tsx ../agent/src/cli/main.ts",
        "runtime:mcp": "node --conditions=development --import tsx ../devkit/src/mcp/main.ts",
        "start:sandbox": "node tools/sandbox-project.mjs",
        "test": "vitest run",
        "typecheck": "tsc -b ../devkit ../agent && tsc -b && tsc -p tsconfig.server.json --noEmit",
        "predev": "npm run build:shared --prefix ..",
        "dev:server": "tsx watch --conditions=development src/server/main.ts"
    },
    "dependencies": {
        "@assistant-ui/react": "^0.15.16",
        "@assistant-ui/react-markdown": "^0.14.12",
        "@codingame/monaco-vscode-api": "25.1.2",
        "@codingame/monaco-vscode-editor-api": "25.1.2",
        "@codingame/monaco-vscode-files-service-override": "25.1.2",
        "@codingame/monaco-vscode-standalone-json-language-features": "25.1.2",
        "@codingame/monaco-vscode-standalone-languages": "25.1.2",
        "@codingame/monaco-vscode-views-service-override": "25.1.2",
        "@earendil-works/pi-agent-core": "^0.84.2",
        "@earendil-works/pi-ai": "^0.84.2",
        "@headless-tree/core": "^1.7.0",
        "@headless-tree/react": "^1.7.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "dockview-react": "^8.2.0",
        "lucide-react": "^1.33.0",
        "material-icon-theme": "^5.37.0",
        "monaco-editor": "^0.55.1",
        "monaco-languageclient": "^10.7.0",
        "radix-ui": "^1.6.7",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.6.0",
        "typebox": "^1.3.16",
        "vscode": "npm:@codingame/monaco-vscode-extension-api@25.1.2",
        "ws": "^8.21.3",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@entisium/agent": "0.1.0",
        "@entisium/devkit": "0.1.0",
        "yaml": "^2.9.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/wicg-file-system-access": "^2023.10.7",
        "@types/ws": "^8.18.1",
        "@vitejs/plugin-react": "^6.1.0",
        "concurrently": "^10.0.5",
        "tailwindcss": "^4.3.3",
        "vite": "^8.2.2"
    }
}
