{
    "name": "@entisium/editor",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "node tools/dev.mjs",
        "dev:host": "tsx watch host/main.ts",
        "dev:renderer": "vite",
        "dev:sandbox": "npm run sandbox:prepare && npm run dev -- --project ../.sandbox/editor-project",
