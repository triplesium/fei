{
    "name": "@fei/editor",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "build": "npm run build:renderer && npm run build:host",
        "build:host": "tsc -p tsconfig.host.json",
        "build:renderer": "tsc -b && vite build",
        "dev": "node tools/dev.mjs",
        "dev:host": "tsx watch host/main.ts",
        "dev:renderer": "vite",
        "dev:sandbox": "npm run sandbox:prepare && npm run dev -- --project ../.sandbox/editor-project",
        "sandbox:prepare": "node tools/sandbox-project.mjs --prepare-only",
        "start": "npm run build && node host-dist/main.js",
        "start:sandbox": "npm run build && node tools/sandbox-project.mjs",
        "test": "vitest run",
        "typecheck": "tsc -b && tsc -p tsconfig.host.json --noEmit"
    },
    "dependencies": {
        "@assistant-ui/react": "^0.15.16",
        "@earendil-works/pi-agent-core": "^0.84.2",
        "@earendil-works/pi-ai": "^0.84.2",
        "@monaco-editor/react": "^4.7.0",
        "dockview-react": "^8.2.0",
        "lucide-react": "^1.33.0",
        "monaco-editor": "^0.56.0",
        "radix-ui": "^1.6.7",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "typebox": "^1.3.16",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/wicg-file-system-access": "^2023.10.7",
        "@vitejs/plugin-react": "^6.1.0",
        "concurrently": "^10.0.5",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "overrides": {
        "dompurify": "^3.4.14"
    }
}
