{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "rootDir": "src",
        "outDir": "dist",
        "types": [
            "node"
        ]
    },
    "include": [
        "src/server/**/*.ts",
        "src/shared/**/*.ts"
    ],
    "exclude": [
        "src/**/*.test.ts"
    ]
}
